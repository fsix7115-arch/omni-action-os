# Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder, not a real credential.

# Database. SQLite is the default for the local-lite profile.
DATABASE_URL="file:./dev.db"

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-random-hex-string"

# Public origin, used for absolute links in the audit journal.
APP_URL="http://localhost:3000"

# Port for the dev server. The doctor warns when this is already taken.
PORT=3000
