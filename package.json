{
  "name": "omni-action-os",
  "version": "0.1.0",
  "private": false,
  "description": "A universal AI action workspace: intent -> plan -> permission -> execute -> verify.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "python3 scripts/doctor.py",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:doctor": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.454.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@playwright/test": "^1.48.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18"
  }
}